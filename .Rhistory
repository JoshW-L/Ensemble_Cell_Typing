obj,
only.pos = TRUE,
logfc.threshold = 0.1,
min.pct = 0.1,
test.use = "wilcox",
assay = DefaultAssay(obj),
p.adjust.method = "bonferroni"
) %>%
filter(p_val_adj < 0.1)
write.csv(markers, file.path(output_dir, paste0(obj_name, "_cluster_markers.csv")), row.names = FALSE)
}
